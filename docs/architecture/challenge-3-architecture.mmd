flowchart TB
    User([User / Browser]) -->|HTTP 80| IGW[Internet Gateway]

    subgraph VPC["VPC 10.0.0.0/16"]
      direction TB
      subgraph Public["Public subnets - two Availability Zones"]
        ALB[Application Load Balancer]
        NAT[NAT Gateway]
      end
      subgraph Private["Private subnets - two Availability Zones"]
        EC2A[EC2 + nginx - AZ A]
        EC2B[EC2 + nginx - AZ B]
        S3EP[S3 Gateway endpoint]
      end
      IGW --> ALB
      ALB -->|ALB security group to EC2 security group| EC2A
      ALB -->|ALB security group to EC2 security group| EC2B
      EC2A -. package egress .-> NAT
      EC2B -. package egress .-> NAT
      EC2A --> S3EP
      EC2B --> S3EP
      NAT --> IGW
    end

    S3EP --> S3[(Private S3 bucket)]
    Control[Ansible control node] -->|AWS Systems Manager - no SSH| EC2A
    Control -->|AWS Systems Manager - no SSH| EC2B

    classDef public fill:#fff3e0,stroke:#e65100,color:#222;
    classDef private fill:#e8f5e9,stroke:#2e7d32,color:#222;
    classDef managed fill:#e3f2fd,stroke:#1565c0,color:#222;
    class ALB,NAT public;
    class EC2A,EC2B,S3EP private;
    class S3,Control managed;
